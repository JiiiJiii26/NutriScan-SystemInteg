# ===========================================================
# NutriScan Environment Variables Example
# ===========================================================

# -----------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nutriscan_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# -----------------------------------------------------------
# Google OAuth 2.0 Credentials
# Obtain these from https://console.cloud.google.com/
# Set redirect URI to: http://localhost:8080/login/oauth2/code/google
# -----------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret-here
